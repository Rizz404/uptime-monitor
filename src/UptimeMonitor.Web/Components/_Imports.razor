@* * File ini otomatis berlaku untuk semua komponen di folder Components, jadi @using tidak perlu diulang di tiap file *@
@using System.Globalization
@using System.Net.Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@* ? "using static" membuat InteractiveServer bisa ditulis langsung, tanpa awalan RenderMode. *@
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using UptimeMonitor.Web
@using UptimeMonitor.Web.Components
@using UptimeMonitor.Web.Components.Layout
@using UptimeMonitor.Web.Components.Shared
@using UptimeMonitor.Web.Monitoring.Entities
@using UptimeMonitor.Web.Monitoring.Checking
@using UptimeMonitor.Web.Monitoring.Queries
@using UptimeMonitor.Web.Monitoring.Services
@* * @inject = meminta objek dari DI (seperti constructor di class C#); variabel "L" membuat @L["Key"] bisa dipakai di semua komponen untuk teks sesuai bahasa *@
@inject IStringLocalizer<SharedResource> L
