@* * @page = alamat halaman ini; "/" menjadikannya halaman depan yang bisa dilihat siapa saja *@
@page "/"
@inject StatusQueries Queries

@* * PageTitle mengisi judul tab browser lewat HeadOutlet di App.razor *@
<PageTitle>@L["Status_Title"] · @L["AppName"]</PageTitle>
@* ! Halaman ini statis (tanpa @rendermode), jadi pembaruan otomatis dilakukan dengan meta refresh tiap 30 detik *@
<HeadContent>
    <meta http-equiv="refresh" content="30" />
</HeadContent>

<h1>@L["Status_Title"]</h1>

@* * Spanduk ringkasan punya tiga kemungkinan: belum ada monitor, semua normal, atau sebagian down *@
@if (overview.Monitors.Count == 0)
{
    <p class="banner banner-neutral">@L["Status_Empty"]</p>
}
else if (overview.DownCount == 0)
{
    <p class="banner banner-up">@L["Status_AllUp"]</p>
}
else
{
    @* ? Argumen setelah key mengisi placeholder {0} dan {1} di resx *@
    <p class="banner banner-down">@L["Status_SomeDown", overview.DownCount, overview.Monitors.Count]</p>
}

<section class="monitor-list">
    @* * Satu kartu per monitor *@
    @foreach (var monitor in overview.Monitors)
    {
        <article class="monitor-card">
            <div class="monitor-heading">
                <div>
                    <h2>@monitor.Name</h2>
                    @* ! rel="noopener noreferrer" pada link tab baru mencegah situs tujuan mengakses halaman ini *@
                    <a class="muted" href="@monitor.Url" target="_blank" rel="noopener noreferrer">@monitor.Url</a>
                </div>
                <StatusBadge Status="monitor.Status" />
            </div>
            @* ? <dl> = daftar pasangan label (dt) dan nilai (dd); warna uptime dipilih Display.UptimeClass *@
            <dl class="metrics">
                <div>
                    <dt>@L["Uptime_24Hours"]</dt>
                    <dd class="@Display.UptimeClass(monitor.Uptime24Hours)">@Display.Percentage(monitor.Uptime24Hours)</dd>
                </div>
                <div>
                    <dt>@L["Uptime_7Days"]</dt>
                    <dd class="@Display.UptimeClass(monitor.Uptime7Days)">@Display.Percentage(monitor.Uptime7Days)</dd>
                </div>
                <div>
                    <dt>@L["Uptime_30Days"]</dt>
                    <dd class="@Display.UptimeClass(monitor.Uptime30Days)">@Display.Percentage(monitor.Uptime30Days)</dd>
                </div>
                <div>
                    <dt>@L["Latency"]</dt>
                    @* ? @( ... ) = ekspresi C# lengkap di dalam HTML, di sini dipakai untuk if-else satu baris *@
                    <dd>@(monitor.LastLatencyMs is { } latency ? L["Unit_Milliseconds", latency] : "—")</dd>
                </div>
                <div>
                    <dt>@L["LastChecked"]</dt>
                    <dd>@(monitor.LastCheckedAt is { } checkedAt ? Display.Utc(checkedAt) : L["Never"])</dd>
                </div>
            </dl>
        </article>
    }
</section>

<h2 class="section-title">@L["Incidents_Title"]</h2>

@if (overview.Incidents.Count == 0)
{
    <p class="muted">@L["Incidents_Empty"]</p>
}
else
{
    <ul class="incident-list">
        @foreach (var incident in overview.Incidents)
        {
            @* * Insiden yang belum selesai (ResolvedAt null) diberi class dan lencana merah *@
            <li class="incident @(incident.ResolvedAt is null ? "incident-open" : string.Empty)">
                <div class="incident-heading">
                    <strong>@incident.MonitorName</strong>
                    <span class="badge @(incident.ResolvedAt is null ? "badge-down" : "badge-up")">
                        @(incident.ResolvedAt is null ? L["Incident_Ongoing"] : L["Incident_Resolved"])
                    </span>
                </div>
                <p>@incident.Cause</p>
                <p class="muted">
                    @L["Incident_Started"]: @Display.Utc(incident.StartedAt)
                    @if (incident.ResolvedAt is { } resolvedAt)
                    {
                        <span> · @L["Incident_Resolved"]: @Display.Utc(resolvedAt)</span>
                    }
                </p>
            </li>
        }
    </ul>
}

@* * @code = bagian C# milik komponen ini *@
@code {
    // ? Diisi data kosong lebih dulu agar tampilan di atas tidak menemui null selagi data belum dimuat
    private StatusOverview overview = new([], []);

    // * Dijalankan sekali saat halaman dibuat: data dimuat dari StatusQueries (Langkah 7)
    protected override async Task OnInitializedAsync() => overview = await Queries.GetOverviewAsync();
}
