@* * Dokumen HTML utama: semua halaman ditampilkan di dalam <Routes /> pada file ini *@
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* ? @Assets[...] menghasilkan alamat file dengan kode versi, jadi browser memuat ulang otomatis saat file berubah *@
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* ? File ini gabungan CSS khusus komponen (berkas .razor.css) yang dibuat otomatis saat build *@
    <link rel="stylesheet" href="@Assets["UptimeMonitor.Web.styles.css"]" />
    <ImportMap />
    @* * HeadOutlet = tempat halaman menyisipkan isi <head> sendiri, misalnya judul tab *@
    <HeadOutlet />
</head>

<body>
    <Routes />
    @* * Dialog yang tampil saat koneksi ke server terputus *@
    <ReconnectModal />
    @* ! Skrip ini yang membuat halaman interaktif; tanpanya komponen hanya tampil statis *@
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
